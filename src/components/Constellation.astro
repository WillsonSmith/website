---
// The bare constellation (lines + stars, no labels) used for the sky echoes
// beside/above each chapter. The plate's own figure keeps its inline SVG
// since it also carries star labels.
interface Props {
  stars: { x: number; y: number; r: number; bright?: boolean }[];
  links: string[];
}
const { stars, links } = Astro.props;
---

<svg viewBox="0 0 340 200">
  <g class="chart__lines">
    {links.map((pts) => <polyline points={pts} />)}
  </g>
  <g class="chart__stars">
    {
      stars.map((st) => (
        <circle
          cx={st.x}
          cy={st.y}
          r={st.r}
          class={st.bright ? "chart__star--bright" : ""}
        />
      ))
    }
  </g>
</svg>
