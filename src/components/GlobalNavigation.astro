---
const links: { url: string; title: string }[] = [
  { url: "https://github.com/willsonsmith", title: "Github" },
  { url: "https://www.linkedin.com/in/willsonsmith/", title: "LinkedIn" },
];
---

<header class="global-navigation">
  <h1>Willson Smith</h1>
  <nav class="links">
    {
      links.map(({ url, title }) => (
        <a href={url} target="_blank">
          {title}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .global-navigation {
    color: var(--color-text);

    position: sticky;
    top: 0;
    z-index: 10;

    display: flex;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);

    padding-block: var(--space-2xs);
    padding-inline: var(--space-fluid-md);

    .links {
      display: flex;
      gap: var(--space-sm);
      margin-inline-start: auto;
    }

    a {
      color: var(--color-text-muted);
      text-decoration: none;
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;

      scale: 1;
      transform-origin: 50% 100%;
      transition:
        scale 120ms var(--ease-out),
        color 120ms var(--ease-out);

      &:hover {
        scale: 1.08;
        color: var(--color-accent);
      }
    }

    h1 {
      flex: 1 1 auto;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-tight);
      white-space: nowrap;
    }
  }

  /* Stack the title over the links once a single row gets cramped. */
  @media (max-width: 30rem) {
    .global-navigation {
      flex-direction: column;
      align-items: flex-start;
    }

    .global-navigation h1 {
      font-size: var(--text-md);
    }

    .global-navigation .links {
      margin-inline-start: 0;
    }
  }
</style>
