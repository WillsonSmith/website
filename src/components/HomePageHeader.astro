---
const imageSize = 200;
---

<h-image-swap>
  <div class="image">
    <picture>
      <source srcset="/images/thumbs-up.avif" type="image/avif" />
      <img
        loading="lazy"
        alt="An avatar of Willson waving at the screen."
        src="/images/thumbs-up.png"
        width={imageSize}
        height={imageSize}
      />
    </picture>
    <picture>
      <source srcset="/images/peace.avif" type="image/avif" />
      <img
        loading="lazy"
        alt=""
        src="/images/peace.png"
        width={imageSize}
        height={imageSize}
      />
    </picture>
  </div>
</h-image-swap>

<style>
  h-image-swap {
    display: grid;
    place-items: center;
    height: var(--space-3xl);

    .image {
      display: grid;
      grid-template-areas: "main";
      place-items: center;

      max-inline-size: 200px;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-blob);
      padding: var(--space-2xs);

      /* A pool of light the avatar sits in, tinted by the hour */
      background: radial-gradient(
        circle at 50% 55%,
        color-mix(in oklch, var(--color-accent), transparent 75%),
        transparent 70%
      );
    }

    img {
      block-size: auto;
      max-inline-size: 100%;
    }

    picture {
      grid-area: main;
      opacity: 0;
    }
    /* waving by default (and as a no-scroll-timeline fallback) */
    picture:nth-child(1) {
      opacity: 1;
    }
  }
</style>

<!-- Global so Astro doesn't scope the @keyframes away from their
     animation-name. Scroll-driven crossfade: wave -> peace as the avatar
     leaves the top of the viewport. Composited opacity, no repaint. -->
<style is:global>
  @supports (animation-timeline: view()) {
    h-image-swap picture:nth-child(1) {
      animation: avatar-wave linear both;
      animation-timeline: view();
      animation-range: exit 15% exit 85%;
    }
    h-image-swap picture:nth-child(2) {
      animation: avatar-peace linear both;
      animation-timeline: view();
      animation-range: exit 15% exit 85%;
    }
  }
  @keyframes avatar-wave {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes avatar-peace {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
