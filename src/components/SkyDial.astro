---
// The time-of-day control: a luminary orbiting the avatar on a ring.
// Drag it around to set the hour; the icon (Lucide) changes with the
// time — sunrise, sun, sunset, moon — and is tinted by the live accent.
// Progressive enhancement: without JS the scene renders at its default
// time and this stays inert. The avatar is provided via the slot.
import sunset from "lucide-static/icons/sunset.svg?raw";
---

<sky-dial class="sky-dial">
  <div class="dial-track" aria-hidden="true"></div>
  <div class="dial-center"><slot /></div>
  <button
    type="button"
    class="dial-handle"
    role="slider"
    aria-label="Time of day"
    aria-valuemin="0"
    aria-valuemax="24"
    aria-valuenow="18"
    aria-valuetext="Dusk"
  >
    <span class="dial-icon" set:html={sunset} />
  </button>
</sky-dial>

<style>
  .sky-dial {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: var(--dial-size);
    block-size: var(--dial-size);
    margin-inline: auto;

    --dial-size: clamp(280px, 62vmin, 380px);
    --dial-hit: 52px;
  }

  /* The sun/moon's orbit around the portrait */
  .dial-track,
  .dial-center {
    grid-area: 1 / 1;
  }
  .dial-track {
    inline-size: 100%;
    block-size: 100%;
    border-radius: 50%;
    border: 1px dashed color-mix(in oklch, var(--color-accent), transparent 72%);
    pointer-events: none;
  }
  .dial-center {
    display: grid;
    place-items: center;
  }

  .dial-handle {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--dial-hit);
    block-size: var(--dial-hit);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--color-accent);
    cursor: grab;
    touch-action: none; /* dragging shouldn't scroll the page */
    /* positioned on the ring by script via transform */
  }
  .dial-handle:active {
    cursor: grabbing;
  }
  .dial-handle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .dial-icon {
    display: grid;
    place-items: center;
  }
  .dial-icon :global(svg) {
    inline-size: 30px;
    block-size: 30px;
    /* A luminous halo in the hour's accent, plus a dark edge so a pale
       midday sun still reads against a bright sky. */
    filter: drop-shadow(0 0 7px color-mix(in oklch, var(--color-accent), transparent 30%))
      drop-shadow(0 1px 2px rgb(0 0 0 / 0.45));
  }

  @media (prefers-reduced-motion: reduce) {
    .dial-icon :global(svg) {
      transition: none;
    }
  }
</style>

<script>
  import {
    applyTimeOfDay,
    currentTimeOfDay,
    labelForTime,
  } from "../scripts/sky";
  import sun from "lucide-static/icons/sun.svg?raw";
  import moon from "lucide-static/icons/moon.svg?raw";
  import moonStar from "lucide-static/icons/moon-star.svg?raw";
  import sunrise from "lucide-static/icons/sunrise.svg?raw";
  import sunset from "lucide-static/icons/sunset.svg?raw";

  const ICONS: Record<string, string> = {
    sun,
    moon,
    "moon-star": moonStar,
    sunrise,
    sunset,
  };

  /** Which luminary to show for a given hour. */
  function iconForTime(hour: number): string {
    const t = ((hour % 24) + 24) % 24;
    if (t >= 23 || t < 1) return "moon-star";
    if (t < 5) return "moon";
    if (t < 7) return "sunrise";
    if (t < 16) return "sun";
    if (t < 19) return "sunset";
    return "moon";
  }

  const TAU = Math.PI * 2;
  const wrap24 = (t: number) => ((t % 24) + 24) % 24;

  class SkyDial extends HTMLElement {
    private track!: HTMLElement;
    private handle!: HTMLButtonElement;
    private icon!: HTMLElement;
    private time = 18;
    private iconName = "";

    connectedCallback() {
      this.track = this.querySelector(".dial-track")!;
      this.handle = this.querySelector(".dial-handle")!;
      this.icon = this.querySelector(".dial-icon")!;
      this.time = currentTimeOfDay();

      this.handle.addEventListener("pointerdown", this.onPointerDown);
      this.handle.addEventListener("keydown", this.onKeyDown);
      window.addEventListener("resize", this.position);

      // Wait a frame so layout (and the ring's size) is settled.
      requestAnimationFrame(() => this.setTime(this.time));
    }

    disconnectedCallback() {
      window.removeEventListener("resize", this.position);
    }

    /** Centre + radius of the ring in viewport coordinates (for dragging). */
    private metrics() {
      const r = this.track.getBoundingClientRect();
      return { cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
    }

    private setTime(t: number) {
      this.time = wrap24(t);
      applyTimeOfDay(this.time);
      this.position();
      this.handle.setAttribute("aria-valuenow", this.time.toFixed(2));
      this.handle.setAttribute("aria-valuetext", labelForTime(this.time));

      const name = iconForTime(this.time);
      if (name !== this.iconName) {
        this.iconName = name;
        this.icon.innerHTML = ICONS[name];
      }
    }

    /** Place the handle on the ring. Angle is clockwise from the top
        (noon), so time advances clockwise: noon→dusk→midnight→dawn.
        Centre is read from layout rects (post-transform) and expressed
        relative to the host, which is the handle's containing block. */
    private position = () => {
      const host = this.getBoundingClientRect();
      const track = this.track.getBoundingClientRect();
      const cx = track.left + track.width / 2 - host.left;
      const cy = track.top + track.height / 2 - host.top;
      const radius = track.width / 2;
      const angle = ((this.time - 12) / 24) * TAU;
      const x = cx + radius * Math.sin(angle);
      const y = cy - radius * Math.cos(angle);
      this.handle.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
    };

    private onPointerDown = (event: PointerEvent) => {
      event.preventDefault();
      this.handle.setPointerCapture(event.pointerId);
      // Snap colour updates to the drag (no 700ms lag while scrubbing).
      document.documentElement.dataset.skyDragging = "";
      this.handle.addEventListener("pointermove", this.onPointerMove);
      this.handle.addEventListener("pointerup", this.onPointerUp);
      this.handle.addEventListener("pointercancel", this.onPointerUp);
    };

    private onPointerMove = (event: PointerEvent) => {
      const { cx, cy } = this.metrics();
      const angle = Math.atan2(event.clientX - cx, -(event.clientY - cy));
      this.setTime(12 + (angle / TAU) * 24);
    };

    private onPointerUp = (event: PointerEvent) => {
      delete document.documentElement.dataset.skyDragging;
      this.handle.releasePointerCapture?.(event.pointerId);
      this.handle.removeEventListener("pointermove", this.onPointerMove);
      this.handle.removeEventListener("pointerup", this.onPointerUp);
      this.handle.removeEventListener("pointercancel", this.onPointerUp);
    };

    private onKeyDown = (event: KeyboardEvent) => {
      const step = event.shiftKey ? 3 : 0.5;
      let handled = true;
      switch (event.key) {
        case "ArrowRight":
        case "ArrowUp":
          this.setTime(this.time + step);
          break;
        case "ArrowLeft":
        case "ArrowDown":
          this.setTime(this.time - step);
          break;
        case "PageUp":
          this.setTime(this.time + 3);
          break;
        case "PageDown":
          this.setTime(this.time - 3);
          break;
        case "Home":
          this.setTime(12); // midday
          break;
        case "End":
          this.setTime(0); // midnight
          break;
        default:
          handled = false;
      }
      if (handled) event.preventDefault();
    };
  }

  if (!customElements.get("sky-dial")) {
    customElements.define("sky-dial", SkyDial);
  }
</script>
