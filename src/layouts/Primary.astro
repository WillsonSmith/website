---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const description =
  "Willson Smith is a software developer with a specialization in user experience and front-end development from Toronto, Canada.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <!-- All code is intentionally unminified so that others can learn. -->
    <slot />

    <script>
      // Open the scene at the visitor's local time (or a ?time= override).
      import { applyTimeOfDay, currentTimeOfDay } from "../scripts/sky";
      applyTimeOfDay(currentTimeOfDay());
    </script>
  </body>
</html>
