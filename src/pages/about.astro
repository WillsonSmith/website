---
import Primary from "../layouts/Primary.astro";

const title = "About me";
---

<Primary title="About">
  <main class="about-heading">
    <h1>{title}</h1>
  </main>
</Primary>

<style>
  .about-heading {
    margin: 0;
    padding-block: var(--space-2xl);
    padding-inline: var(--space-fluid-md);
  }

  .about-heading h1 {
    font-size: var(--text-xl);
  }
</style>
