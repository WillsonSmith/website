---
// The home page, drawn in the modfox brand at Sheet level.
// The same four chapters (from the `index` content collection) become
// four sheets of one drawing set; each chapter's constellation becomes a
// plotted figure.
import { getCollection, render } from "astro:content";
import Sheet from "../layouts/Sheet.astro";

const entries = (await getCollection("index")).sort(
  (a, b) => a.data.order - b.data.order,
);

const blocks = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { order: entry.data.order, title: entry.data.title, Content };
  }),
);

type Star = { x: number; y: number; r: number; bright?: boolean };
type Label = { x: number; y: number; t: string };
type Note = { text: string; arrow: string };
type Chapter = {
  kicker: string;
  fig: string;
  figName: string;
  stars: Star[];
  links: string[];
  labels: Label[];
  note: Note;
};

// Same star data as the live page; presentation only.
const chapters: Record<number, Chapter> = {
  1: {
    kicker: "Introduction",
    fig: "Fig. i",
    figName: "Ursa Minor, the guiding star",
    stars: [
      { x: 276, y: 52, r: 3.2, bright: true },
      { x: 242, y: 68, r: 2 },
      { x: 208, y: 82, r: 2.2 },
      { x: 176, y: 94, r: 2.8, bright: true },
      { x: 150, y: 128, r: 2.2 },
      { x: 104, y: 134, r: 2 },
      { x: 96, y: 100, r: 2.2 },
    ],
    links: ["276,52 242,68 208,82 176,94 150,128 104,134 96,100 176,94"],
    labels: [{ x: 250, y: 40, t: "POLARIS" }],
    note: { text: "start here", arrow: "M6 30 C 20 12, 44 6, 70 10 M70 10 L 61 5 M70 10 L 62 16" },
  },
  2: {
    kicker: "Approach",
    fig: "Fig. ii",
    figName: "Lyra, the storyteller’s lyre",
    stars: [
      { x: 180, y: 54, r: 3, bright: true },
      { x: 150, y: 96, r: 2.2 },
      { x: 188, y: 108, r: 2 },
      { x: 208, y: 150, r: 2.4 },
      { x: 168, y: 150, r: 2 },
    ],
    links: ["180,54 150,96 168,150 208,150 188,108 150,96"],
    labels: [{ x: 196, y: 50, t: "VEGA" }],
    note: { text: "a lyre, if you squint", arrow: "M6 30 C 22 14, 46 8, 70 12 M70 12 L 61 7 M70 12 L 62 18" },
  },
  3: {
    kicker: "Practice",
    fig: "Fig. iii",
    figName: "Draco, the sleepless dragon",
    stars: [
      { x: 44, y: 168, r: 2.4 },
      { x: 80, y: 150, r: 2 },
      { x: 96, y: 120, r: 2.6 },
      { x: 82, y: 92, r: 2 },
      { x: 116, y: 80, r: 2.4 },
      { x: 150, y: 92, r: 3, bright: true },
      { x: 186, y: 76, r: 2.2 },
      { x: 214, y: 88, r: 2 },
      { x: 248, y: 72, r: 2.6 },
      { x: 281, y: 60, r: 3, bright: true },
      { x: 298, y: 82, r: 2.2 },
      { x: 268, y: 94, r: 2.4 },
    ],
    links: [
      "44,168 80,150 96,120 82,92 116,80 150,92 186,76 214,88 268,94 248,72 281,60 298,82 268,94",
    ],
    labels: [
      { x: 150, y: 112, t: "α" },
      { x: 281, y: 44, t: "β" },
    ],
    note: { text: "still awake", arrow: "M6 30 C 20 16, 42 8, 70 12 M70 12 L 61 7 M70 12 L 62 18" },
  },
  4: {
    kicker: "Contact",
    fig: "Fig. iv",
    figName: "Sagitta, the arrow",
    stars: [
      { x: 256, y: 64, r: 2.8, bright: true },
      { x: 204, y: 90, r: 2.2 },
      { x: 158, y: 110, r: 2.4 },
      { x: 126, y: 96, r: 2 },
      { x: 132, y: 134, r: 2 },
    ],
    links: ["256,64 204,90 158,110", "126,96 158,110 132,134"],
    labels: [{ x: 256, y: 46, t: "γ" }],
    note: { text: "this way", arrow: "M70 8 C 50 10, 24 18, 8 34 M8 34 L 10 24 M8 34 L 18 32" },
  },
};

const total = blocks.length;
const roman = ["i", "ii", "iii", "iv", "v", "vi"];
const zonesX = [1, 2, 3, 4, 5, 6, 7, 8];
const zonesY = ["A", "B", "C", "D", "E", "F"];
const today = new Date();
const year = today.getFullYear();

const links = [
  { url: "https://github.com/willsonsmith", title: "GitHub" },
  { url: "https://www.linkedin.com/in/willsonsmith/", title: "LinkedIn" },
];

// Rough width of a mono label in chart units, for its paper patch.
const patchW = (t: string) => t.length * 6.4 + 8;
---

<Sheet title="Willson Smith">
  <div class="sheet">
    <!-- Zone references round the sheet border: numbers across, letters down. -->
    <ol class="zones zones--top" aria-hidden="true">
      {zonesX.map((n) => <li>{n}</li>)}
    </ol>
    <ol class="zones zones--bottom" aria-hidden="true">
      {zonesX.map((n) => <li>{n}</li>)}
    </ol>
    <ol class="zones zones--left" aria-hidden="true">
      {zonesY.map((n) => <li>{n}</li>)}
    </ol>
    <ol class="zones zones--right" aria-hidden="true">
      {zonesY.map((n) => <li>{n}</li>)}
    </ol>

    <!-- ===== Title ===== -->
    <header class="title">
      <div class="title__bar">
        <p class="label">Dwg. WS-001 · Rev. C</p>
        <nav class="title__nav" aria-label="Elsewhere">
          {
            links.map(({ url, title }) => (
              <a class="btn" href={url} target="_blank" rel="noopener">
                {title}
              </a>
            ))
          }
          <button type="button" class="btn theme-toggle" aria-pressed="false">
            <span class="theme-toggle__label">Print</span>
            <span class="theme-toggle__value">Vellum</span>
          </button>
        </nav>
      </div>

      <div class="title__main">
        <div class="title__words">
          <h1 class="wordmark">Willson Smith</h1>
          <p class="title__lede">
            A developer who likes to help people do neat things.
          </p>
          <ol class="index" aria-label="Sheets in this set">
            {
              blocks.map(({ order, title }) => (
                <li>
                  <a href={`#sheet-${order}`}>
                    <span class="label">Sht. {order}</span>
                    <span class="index__title">{title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        <figure class="avatar">
          <div class="avatar__ring">
            <div class="avatar__face">
              <picture class="avatar__img avatar__img--a">
                <source srcset="/images/thumbs-up.avif" type="image/avif" />
                <img
                  alt="Willson’s avatar, giving a thumbs up."
                  src="/images/thumbs-up.png"
                  width="200"
                  height="200"
                />
              </picture>
              <picture class="avatar__img avatar__img--b" aria-hidden="true">
                <source srcset="/images/peace.avif" type="image/avif" />
                <img alt="" src="/images/peace.png" width="200" height="200" />
              </picture>
              <span class="avatar__hatch" aria-hidden="true"></span>
            </div>
          </div>
          <span class="avatar__dim label" aria-hidden="true">Ø 4 mod</span>
          <p class="note note--avatar" aria-hidden="true">
            <svg class="note__arrow" viewBox="0 0 76 40" data-rough="arrow" data-seed="avatar">
              <path class="css-line" d="M70 6 C 52 4, 22 12, 8 32" />
              <path class="css-line" d="M8 32 L 9 22 M8 32 L 17 28" />
            </svg>
            <span>that’s me</span>
          </p>
        </figure>

        <dl class="plate spec">
          <div class="plate__head">
            <span class="label">Spec</span>
            <span class="label">Cover</span>
          </div>
          <div class="spec__row"><dt class="label">Discipline</dt><dd>Front-end → full-stack</dd></div>
          <div class="spec__row"><dt class="label">Formerly</dt><dd>Sr. Creative Technologist, Shopify</dd></div>
          <div class="spec__row"><dt class="label">Tenure</dt><dd>8 yrs</dd></div>
          <div class="spec__row"><dt class="label">Datum</dt><dd>Toronto, Canada</dd></div>
          <div class="spec__row">
            <dt class="label">Status</dt>
            <dd><span class="status">Working solo · open to projects</span></dd>
          </div>
        </dl>
      </div>

    </header>

    <!-- ===== Sheets ===== -->
    <main>
      {
        blocks.map(({ order, title, Content }) => {
          const c = chapters[order];
          const side = order % 2 ? "right" : "left";
          return (
            <section
              class:list={["sec", `sec--fig-${side}`]}
              id={`sheet-${order}`}
              aria-labelledby={`sheet-${order}-title`}
            >
              <div class="sec__rule" data-rough="rule" data-seed={`rule-${order}`}>
                <span class="css-line" />
              </div>
              <p class="label sec__kicker">
                Sheet {order} of {total} · {c.kicker}
              </p>
              <h2 class="hand-title" id={`sheet-${order}-title`}>
                {title}
              </h2>

              <div class="sec__body">
                <div class="prose">
                  <Content />
                  {order === total && (
                    <div class="plate contact" data-rough="rect" data-seed="contact">
                      <div class="plate__head">
                        <span class="label">Correspondence</span>
                        <span class="label">Resp. TBD</span>
                      </div>
                      <div class="spec__row">
                        <span class="label">Email</span>
                        <a class="mono" href="mailto:me@willsonsmith.com">
                          me@willsonsmith.com
                        </a>
                      </div>
                      {links.map(({ url, title }) => (
                        <div class="spec__row">
                          <span class="label">{title}</span>
                          <a class="mono" href={url} target="_blank" rel="noopener">
                            {url.replace("https://", "").replace("www.", "")}
                          </a>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <figure class="fig">
                  <div class="fig__frame">
                    <span class="fig__corner label" aria-hidden="true">
                      {c.fig}
                    </span>
                    <svg
                      viewBox="0 0 340 200"
                      class="chart"
                      role="img"
                      aria-label={`${c.figName}: ${c.stars.length} stars`}
                      data-rough="links"
                      data-seed={`fig-${order}`}
                    >
                      <g class="chart__construction">
                        {[68, 136, 204, 272].map((x) => (
                          <line x1={x} y1="0" x2={x} y2="200" />
                        ))}
                        {[50, 100, 150].map((y) => (
                          <line x1="0" y1={y} x2="340" y2={y} />
                        ))}
                      </g>
                      <g class="chart__links css-line">
                        {c.links.map((pts) => (
                          <polyline points={pts} />
                        ))}
                      </g>
                      <g class="chart__hand" />
                      <g class="chart__stars">
                        {c.stars.map((st) => (
                          <>
                            {st.bright && (
                              <circle cx={st.x} cy={st.y} r={st.r + 4} class="chart__ring" />
                            )}
                            <circle cx={st.x} cy={st.y} r={st.r} />
                          </>
                        ))}
                      </g>
                      {c.labels.map((l) => (
                        <g class="chart__note">
                          <rect
                            x={l.x - patchW(l.t) / 2}
                            y={l.y - 7}
                            width={patchW(l.t)}
                            height="12"
                          />
                          <text x={l.x} y={l.y + 2.5}>
                            {l.t}
                          </text>
                        </g>
                      ))}
                    </svg>
                  </div>

                  <div class="dim" aria-hidden="true">
                    <span class="dim__tick" />
                    <span class="dim__line" />
                    <span class="dim__value">{c.stars.length} stars · not to scale</span>
                    <span class="dim__line" />
                    <span class="dim__tick" />
                  </div>

                  <figcaption>
                    <span class="label">{c.fig}</span> {c.figName}
                  </figcaption>

                  <p class:list={["note", `note--fig-${order}`]} aria-hidden="true">
                    <span>{c.note.text}</span>
                    <svg
                      class="note__arrow"
                      viewBox="0 0 76 40"
                      data-rough="arrow"
                      data-seed={`note-${order}`}
                    >
                      <path class="css-line" d={c.note.arrow} />
                    </svg>
                  </p>
                </figure>
              </div>
            </section>
          );
        })
      }
    </main>

    <!-- ===== Title block ===== -->
    <footer class="titleblock" aria-label="Title block">
      <div class="tb tb--name">
        <span class="label">Project</span>
        <span class="tb__value">willsonsmith.com</span>
      </div>
      <div class="tb">
        <span class="label">Drawn</span>
        <span class="tb__value">W. Smith</span>
      </div>
      <div class="tb">
        <span class="label">Scale</span>
        <span class="tb__value">Not to scale</span>
      </div>
      <div class="tb">
        <span class="label">Rev.</span>
        <span class="tb__value">C · {year}</span>
      </div>
      <div class="tb">
        <span class="label">Sheet</span>
        <span class="tb__value">{total} of {total}</span>
      </div>
    </footer>
  </div>
</Sheet>

<script>
  import "../scripts/pencil";

  // Enhance <email-link> elements authored in the markdown content.
  if (!customElements.get("email-link")) {
    customElements.define(
      "email-link",
      class extends HTMLElement {
        connectedCallback() {
          const email = this.textContent?.replace("[at]", "@");
          if (email) this.innerHTML = `<a href="mailto:${email}">${email}</a>`;
        }
      },
    );
  }
</script>
